# Compilation reproductible sur Raspberry Pi ARM64.
FROM debian:trixie-slim AS compilation
RUN apt-get update && apt-get install -y --no-install-recommends g++ cmake make libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /code
COPY CMakeLists.txt ./
COPY serveur-central/ serveur-central/
COPY serveur-local/ serveur-local/
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel 2

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-0 python3 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -c 'import sqlite3; print("SQLite Python", sqlite3.sqlite_version)' \
    && useradd --system --uid 10001 --create-home controle \
    && mkdir -p /donnees && chown 10001:10001 /donnees
COPY --from=compilation /code/build/serveur-local /usr/local/bin/serveur-local
COPY --from=compilation /code/build/controle-local /usr/local/bin/controle-local
COPY serveur-local/importer-snapshot.py /usr/local/bin/importer-snapshot.py
COPY serveur-local/surveiller-cache.py /usr/local/bin/surveiller-cache.py
USER controle
ENTRYPOINT ["/usr/local/bin/serveur-local"]
