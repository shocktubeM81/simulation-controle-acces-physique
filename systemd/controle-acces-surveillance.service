[Unit]
Description=Surveillance de fraicheur du cache SQLite de controle d'acces
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/controle-acces/synchronisation.conf
ExecStart=/usr/local/libexec/controle-acces/surveiller-systemd.sh
TimeoutStartSec=45
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
