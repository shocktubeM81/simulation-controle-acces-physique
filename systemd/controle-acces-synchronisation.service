[Unit]
Description=Synchronisation SQLite du controle d'acces (prototype)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/controle-acces/synchronisation.conf
ExecStart=/usr/local/libexec/controle-acces/synchroniser-systemd.sh
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/docker /run/docker.sock /tmp
